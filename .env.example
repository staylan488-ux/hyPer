# Copy to .env in the repository root; never commit it. Release builds
# (native/scripts/build-phone.sh and scripts/ship.sh) read these values. The
# names keep the VITE_ prefix from the retired web app.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional: the private photo worker, for phone builds only (build-phone.sh).
# App Store builds (scripts/ship.sh) leave it out. API keys stay in Edge
# Function secrets.
VITE_PHOTO_WORKER_URL=https://your-private-worker-host.example:8443
# Optional: crash reporting (Sentry), read by scripts/ship.sh. Without the DSN
# the app reports nothing; without the token the build uploads no source maps.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
