# Copy to .env in the repository root; never commit it. Release builds
# (native/scripts/build-phone.sh and scripts/ship.sh) read these values. The
# names keep the VITE_ prefix from the retired web app.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional: the private photo worker. API keys stay in Edge Function secrets.
VITE_PHOTO_WORKER_URL=https://your-private-worker-host.example:8443
