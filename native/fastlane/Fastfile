default_platform(:ios)

# The native (React Native) hyPer app as the released app.hyper.mobile.
# Run by scripts/ship.sh from an isolated clone of main, with the production
# EXPO_PUBLIC_* values and HYPER_APP=release in the environment. Secrets
# (ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_PATH) come from ~/.hyper-ship/config.env,
# never from this public repo.
platform :ios do
  desc "Build the native hyPer app and upload it to TestFlight"
  lane :beta do
    UI.user_error!("HYPER_APP=release is required") unless ENV["HYPER_APP"] == "release"
    UI.user_error!("EXPO_PUBLIC_HYPER_PREVIEW=0 is required") unless ENV["EXPO_PUBLIC_HYPER_PREVIEW"] == "0"
    native = File.expand_path("..", __dir__)

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: File.expand_path(ENV["ASC_KEY_PATH"]),
    )

    # The next build number after the highest on TestFlight, whoever shipped it
    # (the retired Capacitor app's builds included). app.config.js gives it to
    # the app and the widget extension alike.
    next_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "app.hyper.mobile",
    ).to_i + 1

    # The version people see goes up on every ship as well: the latest upload's
    # 2.0.4 becomes 2.0.5. app.json's version is the floor, so raising it there
    # (to 2.1.0, say) starts that line on the next ship. Nothing is written back.
    latest_version = lane_context[SharedValues::LATEST_TESTFLIGHT_VERSION].to_s
    next_version = sh("node", "#{native}/scripts/release-version.mjs", latest_version).strip
    UI.user_error!("Could not choose the next version (got #{next_version.inspect})") unless next_version.match?(/\A\d+\.\d+\.\d+\z/)
    # The Discord bot reads "hyPer build <n>" from this line; keep that part.
    UI.important("Shipping native hyPer build #{next_build} as version #{next_version} (after #{latest_version.empty? ? "none" : latest_version})")

    # In the environment for the archive too, not only the prebuild: Xcode
    # embeds the app config the About screen reads while it archives.
    ENV["HYPER_APP_VERSION"] = next_version
    ENV["HYPER_BUILD_NUMBER"] = next_build.to_s

    signing = "-allowProvisioningUpdates " \
              "-authenticationKeyID #{ENV['ASC_KEY_ID']} " \
              "-authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']} " \
              "-authenticationKeyPath #{File.expand_path(ENV['ASC_KEY_PATH'])}"

    # Install pods explicitly: Expo prebuild can exit successfully after a pod
    # failure. The helper preserves the selected build number, version and
    # release identity while checking that the workspace is ready for archiving.
    sh("'#{native}/scripts/prepare-release.sh' '#{next_build}' '#{next_version}'")

    build_app(
      workspace: "#{native}/ios/hyPerNative.xcworkspace",
      scheme: "hyPerNative",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "#{native}/build",
      output_name: "hyPer.ipa",
      # Inside build/ so ship.sh removes it afterwards (about 2 GB a ship).
      derived_data_path: "#{native}/build/DerivedData",
      clean: true,
      # gym passes these to the App Store export as well; giving them again
      # (export_xcargs) makes xcodebuild refuse the duplicate options.
      xcargs: signing,
    )

    # The archive must be the real app: the production host, no local test
    # backend, the released bundle ID and the build number and version just chosen.
    sh("'#{native}/scripts/check-release.sh' '#{native}/build/hyPer.ipa' '#{next_build}' '#{next_version}'")

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end
end
